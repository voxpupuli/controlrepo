<%- | Sensitive[String] $postgres_password,
      String $server_name,
      String $s3_bucket,
      String $s3_region,
      String $s3_endpoint,
      Sensitive[String] $s3_access_key,
      Sensitive[String] $s3_secret_key
| -%>
# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=<%= $postgres_password %>

# ── Synapse ─────────────────────────────────────────────────
SYNAPSE_SERVER_NAME=<%= $server_name %>
SYNAPSE_REPORT_STATS=yes

# ── Object Storage, for the media-cron service ──────────────
# boto3 reads the AWS_* names; the other two are passed to s3_media_upload.
AWS_ACCESS_KEY_ID=<%= $s3_access_key %>
AWS_SECRET_ACCESS_KEY=<%= $s3_secret_key %>
AWS_DEFAULT_REGION=<%= $s3_region %>
S3_BUCKET=<%= $s3_bucket %>
S3_ENDPOINT=<%= $s3_endpoint %>
